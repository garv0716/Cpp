#include<iostream>
#include<list>
#include<vector>
#include<string>
using namespace std;

class Graph{
    int V;
    list<int> *l;
    bool isUndirected;

public:
    Graph(int V, bool isUndirected = true){
        this->V = V;
        l = new list<int>[V];
        this -> isUndirected = isUndirected;
    }

    void addEdge(int u, int v){
        l[u].push_back(v);
          if (isUndirected){ // false
            l[v].push_back(u);
          }
    }

    void print(){
        for (int u = 0; u < V; u++){
            list<int> &neighbors = l[u];
            cout << u << ":" ;
            for(int v : neighbors){
                cout << v << " ";
            }
            cout << endl;
        }
    }

    void calcIndegree(vector<int> indegree){
        for (int u = 0; u < V; u++){
            list<int> neighbour = l[u];
            for (int v : neighbour){
                indegree[v]++;            }
        }
    }
    void topoSortBfs(){ // kahn's algorithm
        vector<int> indeg(V, 0);
        calcIndegree(indeg);
        queue<int> q;

        // 0 Indegree nodes

        for(int i = 0; i < V; i++){
            if (indeg[i] == 0){
                q.push(i);
            }
        }
        while(q.size() > 0){ 
            int curr = q.front();
            q.pop();
            cout << curr << " ";
            list<int> neighbour = l[curr];

            for(int v : neighbour){
                indeg[v] --;
                if(indeg[v] == 0){
                    q.push(v);
                }
            }

        }
        cout << endl;
    }
};

int main(){
    Graph g(6, false);
    g.addEdge(2, 3);
    g.addEdge(3, 1);
    g.addEdge(4, 0);
    g.addEdge(4, 1);
    g.addEdge(5, 0);
    g.addEdge(5, 2);

 
    
    g.topoSortBfs();
    return 0;
}